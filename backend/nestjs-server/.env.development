# ===========================================
# Development Environment Configuration
# ===========================================

# Application
NODE_ENV=development
PORT=3000
APP_NAME=reminder-api
APP_VERSION=1.0.0

# Database - MongoDB
DB_TYPE=mongodb
MONGO_DB_URI=mongodb://localhost:27017
MONGO_DB_NAME=reminder_dev

# Observability
LOG_LEVEL=debug
LOG_FORMAT=pretty
ENABLE_METRICS=0
ENABLE_TRACING=0

# Security
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
ENABLE_HELMET=1

# Caching
ENABLE_CACHE=0
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL=300

# CORS
CORS_ORIGIN=http://localhost:3000

# Database Seeding (enable for development)
ENABLE_DB_SEEDING=1
