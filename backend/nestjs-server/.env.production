# ===========================================
# Production Environment Configuration
# ===========================================

# Application
NODE_ENV=production
PORT=3000
APP_NAME=reminder-api
APP_VERSION=1.0.0

# Database - MongoDB
DB_TYPE=mongodb
MONGO_DB_URI=mongodb://localhost:27017
MONGO_DB_NAME=reminder

# Observability
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_METRICS=1
METRICS_PORT=9090
ENABLE_TRACING=1
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=reminder-api

# Security
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
ENABLE_HELMET=1

# Caching
ENABLE_CACHE=1
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password
CACHE_TTL=300

# CORS
CORS_ORIGIN=https://your-frontend-domain.com

# Database Seeding (disable for production)
ENABLE_DB_SEEDING=0
