# ===========================================
# Environment Configuration Template
# ===========================================
# Copy this file to .env.development, .env.production, or .env.test
# and fill in the appropriate values.

# ===================
# Application
# ===================
NODE_ENV=development
PORT=3000
APP_NAME=reminder-api
APP_VERSION=1.0.0

# ===================
# Database
# ===================
# Options: 'mongodb' | 'firebase'
DB_TYPE=mongodb

# MongoDB Configuration
MONGO_DB_URI=mongodb://localhost:27017
MONGO_DB_NAME=reminder

# Firebase Configuration (if using firebase)
# FIREBASE_PROJECT_ID=your-project-id
# USE_FIREBASE_EMULATOR=1
# FIREBASE_EMULATOR_HOST=localhost:8081
# FIREBASE_GOOGLE_APP_CREDENTIALS=./path/to/credentials.json

# ===================
# Observability - Logging
# ===================
# Options: 'error' | 'warn' | 'info' | 'debug' | 'verbose'
LOG_LEVEL=info
# Options: 'json' | 'pretty'
LOG_FORMAT=pretty

# ===================
# Observability - Metrics
# ===================
ENABLE_METRICS=0
METRICS_PORT=9090

# ===================
# Observability - Tracing (OpenTelemetry)
# ===================
ENABLE_TRACING=0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=reminder-api

# ===================
# Security
# ===================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
ENABLE_HELMET=1

# ===================
# Caching
# ===================
ENABLE_CACHE=0
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
CACHE_TTL=300

# ===================
# CORS
# ===================
CORS_ORIGIN=http://localhost:3000

# ===================
# Database Seeding
# ===================
ENABLE_DB_SEEDING=0
