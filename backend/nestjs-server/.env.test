# ===========================================
# Test Environment Configuration
# ===========================================

# Application
NODE_ENV=test
PORT=3001
APP_NAME=reminder-api
APP_VERSION=1.0.0

# Database - MongoDB (separate test database)
DB_TYPE=mongodb
MONGO_DB_URI=mongodb://localhost:27017
MONGO_DB_NAME=reminder_test

# Observability (minimal for tests)
LOG_LEVEL=error
LOG_FORMAT=pretty
ENABLE_METRICS=0
ENABLE_TRACING=0

# Security
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=1000
ENABLE_HELMET=0

# Caching (disabled for tests)
ENABLE_CACHE=0
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL=300

# CORS
CORS_ORIGIN=http://localhost:3001

# Database Seeding
ENABLE_DB_SEEDING=0
